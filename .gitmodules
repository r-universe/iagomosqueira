[submodule ".registry"]
	path = .registry
	url = https://github.com/iagomosqueira/iagomosqueira.r-universe.dev
	branch = HEAD
[submodule "FLBRP"]
	path = FLBRP
	url = https://github.com/flr/FLBRP
	branch = devel
[submodule "FLCore"]
	path = FLCore
	url = https://github.com/flr/FLCore
	branch = devel
[submodule "FLa4a"]
	path = FLa4a
	url = https://github.com/flr/FLa4a
	branch = tmb_translation
[submodule "FLasher"]
	path = FLasher
	url = https://github.com/flr/FLasher
	branch = devel
[submodule "mse"]
	path = mse
	url = https://github.com/flr/mse
	branch = devel
[submodule "msemodules"]
	path = msemodules
	url = https://github.com/flr/msemodules
	branch = devel
[submodule "spict"]
	path = spict
	url = https://github.com/iagomosqueira/spict
	subdir = spict
[submodule "wmrkdown"]
	path = wmrkdown
	url = https://github.com/iagomosqueira/wmrkdown
